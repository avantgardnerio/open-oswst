# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
# You might have to increase this further if you allocate large stack variables in the main task
# The main task runs the app and speaker (the radio has its own thread): ~11.7KB
# used at worst (Stack free log, 2026-10-02). Was 64KB, needed for WiFi's heap
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576

# Increase a bit these stack sizes as they are also a bit too small by default
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# You might have to increase this further if you spawn your own Rust threads 
# that allocate large stack variables; or better yet - use 
# `std::thread::Builder::new().stack_size(XXX)` for spawning
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Run at full 240MHz for real-time Codec2
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Custom partition table with open-oswst NVS partition
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../../../partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Disable SPI ISR in IRAM to enable async SPI trait (embedded_hal_async::spi::SpiDevice)
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set

# Quad-I/O flash: code and constants run from flash through a 16KB cache, and
# a miss measured 3.67µs in DIO (src/bin/cache_miss.rs). QIO moves 4 bits per
# clock instead of 2. Both our flash chips (Winbond, Boya) support it. The
# bootloader built from this config sets the chip's QE bit, so flash with
# `--bootloader <built bootloader.bin> --flash-mode qio`, not espflash's own.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Lets the firmware list every task with its stack high-water mark
# (the `Stack free` log line), to size stacks and make room for WiFi
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
