# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
# You might have to increase this further if you allocate large stack variables in the main task
# The main task runs the app and speaker (the radio has its own thread): ~11.7KB
# used at worst (Stack free log, 2026-10-02). Was 64KB, needed for WiFi's heap
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480

# Increase a bit these stack sizes as they are also a bit too small by default
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# You might have to increase this further if you spawn your own Rust threads 
# that allocate large stack variables; or better yet - use 
# `std::thread::Builder::new().stack_size(XXX)` for spawning
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Run at full 240MHz for real-time Codec2
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Custom partition table with open-oswst NVS partition
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../../../partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Disable SPI ISR in IRAM to enable async SPI trait (embedded_hal_async::spi::SpiDevice)
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set

# The GPIO interrupt runs from IRAM (src/devices/irq_pin.rs), so DIO1 stamps a
# packet's end on time even during a flash write; it disarms its pin with
# gpio_intr_disable, which must then be in IRAM too
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y
# App rollback: a new app (PUT /firmware.bin) is pending until it has run a
# minute (src/firmware.rs); a reboot before that and the bootloader goes
# back to the previous one. A bootloader setting: needs one USB flash
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Quad-I/O flash: code and constants run from flash through a 16KB cache, and
# a miss measured 3.67µs in DIO (src/bin/cache_miss.rs). QIO moves 4 bits per
# clock instead of 2. Both our flash chips (Winbond, Boya) support it. The
# bootloader built from this config sets the chip's QE bit, so flash with
# `--bootloader <built bootloader.bin> --flash-mode qio`, not espflash's own.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Lets the firmware list every task with its stack high-water mark
# (the `Stack free` log line), to size stacks and make room for WiFi
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# Each task's CPU time, in microseconds from esp_timer (the `CPU` log line):
# what starves what. Costs a timer read per context switch
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

# Lean WiFi (net.rs): it only carries OTA images, logs and config, so fewer
# buffers and no frame aggregation, to leave heap for the rest of the radio
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
# Keep WiFi and lwIP code in flash, not internal RAM: on the S3 that RAM is
# the heap's, and these cost ~80KB of it (heap 128KB -> 48KB). We don't need
# WiFi fast
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n

# The ESP32-S3R2 has 2MB of PSRAM in the package (efuse PSRAM_CAP=2M; CS is
# GPIO26/SPICS1, already off-limits). It's slower than internal RAM (through
# the cache, shared with the flash) and unreachable while the flash is being
# written, so nothing goes there by default: CAPS_ALLOC means only an explicit
# heap_caps_malloc(MALLOC_CAP_SPIRAM) does. Today that's the log buffer.
# A board without it still boots (IGNORE_NOTFOUND); main.rs falls back
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
