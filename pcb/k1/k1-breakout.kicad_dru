(version 1)

# Milled in-house with a V-bit whose groove measured ~0.5 mm wide on the first
# board (2026-10-16): copper may come as close as one groove, 0.45 mm (the
# real groove shaves at most 0.025 mm off each edge)
(rule "mill clearance"
  (constraint clearance (min 0.45mm)))
(rule "mill track width"
  (constraint track_width (min 1.0mm)))
(rule "mill hole to copper"
  (constraint hole_clearance (min 0.4mm)))

# The 2.5 jack's middle locating post sits 1.6-1.8 mm from three of its pins.
# Its hole is unplated and connects nothing: it only must not cut into a
# pad's ring. Kept at the 1.7 mm the 3D-printed test plate proved
(rule "post hole to copper"
  (condition "A.Pad_Type == 'NPTH, mechanical' || B.Pad_Type == 'NPTH, mechanical'")
  (constraint hole_clearance (min 0.15mm)))
